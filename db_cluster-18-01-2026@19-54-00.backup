    application_id uuid,
    message_id uuid,
    review_id uuid,
    from_user_id uuid,
    action_url text,
    is_read boolean DEFAULT false,
    read_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now()
);


ALTER TABLE public.notifications OWNER TO postgres;

