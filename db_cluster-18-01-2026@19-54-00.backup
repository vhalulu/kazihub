-- Name: create_profile(uuid, text, text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_profile(p_user_id uuid, p_full_name text, p_phone_number text, p_user_type text) RETURNS void
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  INSERT INTO public.profiles (id, full_name, phone_number, user_type)
  VALUES (
    p_user_id,
    p_full_name,
    p_phone_number,
    p_user_type::public.user_type
  );
END;
$$;


