--
-- Name: COLUMN notifications.action_url; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.notifications.action_url IS 'URL to navigate to when notification is clicked';


--
-- Name: otp_codes; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.otp_codes (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    phone_number text NOT NULL,
    otp_code text NOT NULL,
    is_used boolean DEFAULT false,
    expires_at timestamp with time zone NOT NULL,
    created_at timestamp with time zone DEFAULT now()
);


ALTER TABLE public.otp_codes OWNER TO postgres;

--
-- Name: profiles; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.profiles (
    id uuid NOT NULL,
    full_name text NOT NULL,
    phone_number text NOT NULL,
    user_type public.user_type DEFAULT 'client'::public.user_type,
    avatar_url text,
    county text,
    town text,
    bio text,
    rating numeric(3,2) DEFAULT 0,
    total_tasks_completed integer DEFAULT 0,
    total_earned numeric(10,2) DEFAULT 0,
    available_balance numeric(10,2) DEFAULT 0,
    is_verified boolean DEFAULT false,
    is_pro_tasker boolean DEFAULT false,
    is_business_account boolean DEFAULT false,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    services_offered text[],
    hourly_rate integer,
    daily_rate integer,
    years_experience integer DEFAULT 0,
    is_available boolean DEFAULT true,
    portfolio_images text[],
    profile_photo_url text,
    email text,
    id_document_url text,
    id_document_type text,
    verification_status text,
    verification_submitted_at timestamp with time zone,
    verification_reviewed_at timestamp with time zone,
    verification_notes text,
    is_admin boolean DEFAULT false,
    total_reviews integer DEFAULT 0,
    CONSTRAINT check_positive_rates CHECK (((hourly_rate IS NULL) OR (hourly_rate >= 0)))
);


ALTER TABLE public.profiles OWNER TO postgres;

--
-- Name: COLUMN profiles.is_verified; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.is_verified IS 'Whether user has been verified by admin';


--
-- Name: COLUMN profiles.profile_photo_url; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.profile_photo_url IS 'URL to user profile photo stored in Supabase Storage';


--
-- Name: COLUMN profiles.email; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.email IS 'Optional email for password recovery and notifications';


--
-- Name: COLUMN profiles.id_document_url; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.id_document_url IS 'URL to uploaded ID document (private storage)';


--
-- Name: COLUMN profiles.id_document_type; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.id_document_type IS 'Type of ID: national_id, passport, or drivers_license';


--
-- Name: COLUMN profiles.verification_status; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.verification_status IS 'Status: pending, approved, rejected';


--
-- Name: COLUMN profiles.verification_submitted_at; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.verification_submitted_at IS 'When user submitted verification';


--
-- Name: COLUMN profiles.verification_reviewed_at; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.verification_reviewed_at IS 'When admin reviewed verification';


--
-- Name: COLUMN profiles.verification_notes; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.verification_notes IS 'Admin notes about verification (rejection reason, etc)';


--
-- Name: COLUMN profiles.is_admin; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.profiles.is_admin IS 'Whether user has admin privileges to review verifications';


--
-- Name: reviews; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.reviews (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    task_id uuid NOT NULL,
    reviewer_id uuid NOT NULL,
    reviewee_id uuid NOT NULL,
    rating integer NOT NULL,
    comment text,
    created_at timestamp with time zone DEFAULT now(),
    CONSTRAINT reviews_rating_check CHECK (((rating >= 1) AND (rating <= 5)))
);


ALTER TABLE public.reviews OWNER TO postgres;

--
-- Name: subscriptions; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.subscriptions (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    user_id uuid NOT NULL,
    subscription_type text NOT NULL,
    billing_cycle text NOT NULL,
    amount numeric(10,2) NOT NULL,
    status text DEFAULT 'active'::text,
    starts_at timestamp with time zone NOT NULL,
    expires_at timestamp with time zone NOT NULL,
    next_billing_date timestamp with time zone,
    created_at timestamp with time zone DEFAULT now(),
    cancelled_at timestamp with time zone,
    CONSTRAINT subscriptions_billing_cycle_check CHECK ((billing_cycle = ANY (ARRAY['monthly'::text, 'annual'::text]))),
    CONSTRAINT subscriptions_status_check CHECK ((status = ANY (ARRAY['active'::text, 'cancelled'::text, 'expired'::text]))),
    CONSTRAINT subscriptions_subscription_type_check CHECK ((subscription_type = ANY (ARRAY['tasker_pro'::text, 'business_account'::text])))
);


ALTER TABLE public.subscriptions OWNER TO postgres;

--
-- Name: task_applications; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.task_applications (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    task_id uuid NOT NULL,
    tasker_id uuid NOT NULL,
    proposed_price numeric(10,2),
    cover_message text,
    estimated_duration text,
    status text DEFAULT 'pending'::text,
    created_at timestamp with time zone DEFAULT now(),
    message text,
    rejection_message text,
    CONSTRAINT check_message_not_empty CHECK (((message IS NULL) OR (length(TRIM(BOTH FROM message)) >= 20))),
    CONSTRAINT task_applications_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'accepted'::text, 'rejected'::text, 'withdrawn'::text])))
);


ALTER TABLE public.task_applications OWNER TO postgres;

--
-- Name: tasks; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.tasks (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    client_id uuid NOT NULL,
    title text NOT NULL,
    description text NOT NULL,
    category public.task_category NOT NULL,
    budget numeric(10,2) NOT NULL,
    county text NOT NULL,
    town text,
    specific_location text,
    is_urgent boolean DEFAULT false,
    has_insurance boolean DEFAULT false,
    status public.task_status DEFAULT 'open'::public.task_status,
    assigned_tasker_id uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    completed_at timestamp with time zone,
    max_applications integer,
    CONSTRAINT tasks_budget_check CHECK ((budget >= (100)::numeric))
);


ALTER TABLE public.tasks OWNER TO postgres;

--
-- Name: COLUMN tasks.max_applications; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.tasks.max_applications IS 'Maximum number of applications allowed. NULL means unlimited.';


--
-- Name: transactions; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.transactions (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    task_id uuid,
    task_amount numeric(10,2) NOT NULL,
    urgent_fee numeric(10,2) DEFAULT 0,
    insurance_fee numeric(10,2) DEFAULT 0,
    total_amount numeric(10,2) NOT NULL,
    payer_id uuid NOT NULL,
    payee_id uuid,
    mpesa_receipt_number text,
    mpesa_transaction_id text,
    phone_number text,
    transaction_type text NOT NULL,
    status text DEFAULT 'pending'::text,
    created_at timestamp with time zone DEFAULT now(),
    completed_at timestamp with time zone,
    CONSTRAINT transactions_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'completed'::text, 'failed'::text, 'refunded'::text]))),
    CONSTRAINT transactions_transaction_type_check CHECK ((transaction_type = ANY (ARRAY['task_payment'::text, 'verification'::text, 'subscription'::text, 'withdrawal'::text, 'refund'::text])))
);


ALTER TABLE public.transactions OWNER TO postgres;

--
-- Name: user_verifications; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.user_verifications (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    user_id uuid NOT NULL,
    verification_type text NOT NULL,
    status text DEFAULT 'pending'::text,
    verified_at timestamp with time zone,
    expires_at timestamp with time zone,
    payment_transaction_id uuid,
    created_at timestamp with time zone DEFAULT now(),
    CONSTRAINT user_verifications_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text]))),
    CONSTRAINT user_verifications_verification_type_check CHECK ((verification_type = ANY (ARRAY['id_verified'::text, 'background_check'::text])))
);


ALTER TABLE public.user_verifications OWNER TO postgres;

