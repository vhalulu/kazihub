--
-- Name: get_unread_notification_count(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_unread_notification_count(target_user_id uuid) RETURNS integer
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  RETURN (
    SELECT COUNT(*)::INTEGER
    FROM notifications
    WHERE user_id = target_user_id
    AND is_read = FALSE
  );
END;
$$;


ALTER FUNCTION public.get_unread_notification_count(target_user_id uuid) OWNER TO postgres;

--
-- Name: increment_tasker_completed_tasks(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.increment_tasker_completed_tasks() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  -- Only increment if status changed from something else to 'completed'
  -- AND there is an assigned tasker
  IF NEW.status = 'completed' 
     AND OLD.status != 'completed' 
     AND NEW.assigned_tasker_id IS NOT NULL THEN
    
    UPDATE public.profiles
    SET total_tasks_completed = COALESCE(total_tasks_completed, 0) + 1
    WHERE id = NEW.assigned_tasker_id;
    
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.increment_tasker_completed_tasks() OWNER TO postgres;

--
-- Name: notify_application_accepted(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.notify_application_accepted() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  task_record RECORD;
  client_name TEXT;
BEGIN
  -- Only trigger when status changes to 'accepted'
  IF NEW.status = 'accepted' AND (OLD.status IS NULL OR OLD.status != 'accepted') THEN
    -- Get task details
    SELECT * INTO task_record FROM tasks WHERE id = NEW.task_id;
    
    -- Get client name
    SELECT full_name INTO client_name FROM profiles WHERE id = task_record.client_id;
    
    -- Create notification for tasker
    INSERT INTO notifications (
      user_id,
      type,
      title,
      message,
      action_url,
      task_id,
      application_id,
      from_user_id
    ) VALUES (
      NEW.tasker_id,
      'application_accepted',
      '🎉 You Got Hired!',
      client_name || ' accepted your application for: ' || task_record.title,
      '/my-applications',
      NEW.task_id,
      NEW.id,
      task_record.client_id
    );
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.notify_application_accepted() OWNER TO postgres;

